{
  "name": "magpie-usage-hub",
  "version": "0.6.0",
  "description": "Sync Magpie request usage to a central dashboard with resumable reporting.",
  "keywords": ["magpie-page"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao-xiao-cai/magpie-usage-hub.git"
  },
  "type": "module",
  "exports": {
    "./server": "./server.ts"
  },
  "files": [
    "server.ts",
    "src/",
    "page/",
    "ui/"
  ],
  "magpie": {
    "name": "Magpie Usage Hub",
    "summary": {
      "en": "Report usage from Magpie instances and query request history by source.",
      "zh": "Magpie 实例主动上报用量，中心按来源和时段查询请求明细。"
    },
    "page": {
      "title": "Magpie Usage Hub",
      "file": "page/index.html",
      "service": { "port": 3493 }
    },
    "options": {
      "enabled": false
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
