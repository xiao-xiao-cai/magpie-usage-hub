{
  "name": "magpie-usage-hub",
  "version": "0.5.0",
  "description": "View native gateway usage from multiple Magpie instances in one dashboard.",
  "keywords": ["magpie-page"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao-xiao-cai/magpie-usage-hub.git"
  },
  "type": "module",
  "exports": {
    "./server": "./server.ts"
  },
  "files": [
    "server.ts",
    "src/",
    "page/",
    "ui/"
  ],
  "magpie": {
    "name": "Magpie Usage Hub",
    "summary": {
      "en": "Connect Magpie gateways with read-only keys and view usage by source.",
      "zh": "通过只读 Key 接入 Magpie 网关，按来源查看原生用量。"
    },
    "page": {
      "title": "Magpie Usage Hub",
      "file": "page/index.html",
      "service": { "port": 3493 }
    },
    "options": {
      "enabled": false
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
