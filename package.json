{
  "name": "magpie-usage-hub",
  "version": "0.7.0",
  "description": "Receive native Magpie OTLP usage and query request history in a central dashboard.",
  "keywords": ["magpie-page"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao-xiao-cai/magpie-usage-hub.git"
  },
  "type": "module",
  "exports": {
    "./server": "./server.ts"
  },
  "files": [
    "server.ts",
    "src/",
    "page/",
    "ui/"
  ],
  "magpie": {
    "name": "Magpie Usage Hub",
    "summary": {
      "en": "Receive native Magpie OTLP usage and query history by source and time range.",
      "zh": "接收 Magpie 原生 OTLP 用量，按来源和时段查询历史明细。"
    },
    "page": {
      "title": "Magpie Usage Hub",
      "file": "page/index.html",
      "service": { "port": 3493 }
    },
    "permissions": ["usage:day"],
    "options": {}
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
